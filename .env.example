# Lovable Cloud / Supabase connection (public values, safe to ship in the browser bundle)
# Copy this file to .env and fill in the real values from your Lovable Cloud connection.
# Do not put any private/secret keys here — the service_role key must never live in this project.

VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
