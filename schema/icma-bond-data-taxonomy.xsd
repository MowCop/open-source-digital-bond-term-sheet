<xs:schema xmlns="urn:icma:xsd:ICMABondDataTaxonomy" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:pce="ProductClassificationExtension" xmlns:lpe="LinkedProductsExtension" xmlns:ple="PlatformExtension" targetNamespace="urn:icma:xsd:ICMABondDataTaxonomy" elementFormDefault="qualified" version="2.0.0">
	<xs:include schemaLocation="./icma-bond-data-taxonomy-enums.xsd">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">ICMABondDataTaxonomyEnumerations</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Enumeration codes for use in the ICMA Bond Data Taxonomy.</xs:documentation>
		</xs:annotation>
	</xs:include>
	<xs:include schemaLocation="./icma-bond-data-taxonomy-type-restrictions.xsd">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">ICMABondDataTaxonomyISOTypes</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">ISO codes for use in the ICMA Bond Data Taxonomy.</xs:documentation>
		</xs:annotation>
	</xs:include>
	<xs:element name="Document" type="Document">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">Document</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Top level XML document specification for digitalising issuance, trading, settlement and distribution processes.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<!-- Document definition-->
	<xs:complexType name="Document">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">ICMABondDataTaxonomy</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">ICMA XML specification for primary issuance of notes or securities.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ICMABondDataTaxonomy" type="ICMABondDataTaxonomy">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ICMABondDataTaxonomy</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">ICMA Bond Data Taxonomy (BDT) XML specification.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--ICMA Bond Data Taxonomy-->
	<xs:complexType name="ICMABondDataTaxonomy">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">ICMABondDataTaxonomy</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">ICMA Bond Data Taxonomy (BDT) XML specification.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="DocumentInformation" type="DocumentInformation" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">DocumentInformation</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Common data attributes of the BDT.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<!--Top level element for one or more issuance-->
			<xs:element name="IssuanceDataGroup" type="IssuanceDataGroup" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">IssuanceDataGroup</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Section of the BDT that groups together the primary elements of PartyGroup, Issuance and Product.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IssuanceDataGroup">
		<xs:sequence>
			<xs:element name="IssuanceDescription" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">IssuanceDescription</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Description of issuance and product.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">Class A RegS and 144A</xs:documentation>
				</xs:annotation>
			</xs:element>
			<!--Parties to the issuance-->
			<xs:element name="PartyGroup" type="PartyGroup" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PartyGroup</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Data element group of all parties involved in the transaction.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<!--Details of the Issuance-->
			<xs:element name="Issuance" type="Issuance" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Issuance</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The complex xml type that defines the details of a new issuance.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<!--Details of the Product-->
			<xs:element name="Product" type="Product" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Product</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Attributes of the note being issued as a standalone or as part of a programme.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SeriesTrancheClass" type="SeriesTrancheClassGroup" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SeriesTrancheClass</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Data element that can be used to create multiple issuances or notes that are part of a programme or issuance that includes similar securites that may differ due to regulatory, rating or other parameters.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--PartyRole Definition-->
	<xs:complexType name="PartyRole">
		<xs:choice>
			<xs:element name="PartyRoleType" type="PartyRoleType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PartyRoleType</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Role of the party involved in the issuance or servicing of the security.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">ISSUER</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OtherPartyRoleType" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PartyRoleOtherType</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Role of the party if one is not defined in the enumeration list.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">Unspecified Advisor</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<!--Party Definition-->
	<xs:complexType name="Party">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">Party</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">The name, LEI and other details of the party.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PartyName" type="LEIName" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PartyName</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Name by which a party is known and which is usually used to identify that party.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">EUROPEAN STABILITY MECHANISM</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LEIIdentifier" type="LEIIdentifier" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">LEIIdentifier</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Legal entity identification as an alternate identification for a party.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">222100W4EEAQ77386N50</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BICIdentifier" type="BusinessIdentifierCode" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">BICIdentifier</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Bank Identifier Code of the party.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">ESME</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ParentLEIIdentifier" type="LEIIdentifier" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">LEIIdentifier</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Legal entity identification of the parent entity.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">222100W4EEAQ77386N50</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CountryOfIncorporation" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">CountryOfIncorporation</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Country of incorporation if different or not defined by the LEI.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">LU</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Address" type="Address" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Address</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Address of the party if different or not defined by the LEI.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">6A, CIRCUIT DE LA FOIRE INTERNATIONALE,L-1347,LUXEMBOURG (See Address for details).</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OnBehalfOf" type="Party" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">OnBehalfOf</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Party that this entity is acting on behalf of in the transaction.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">222100W4EEAQ77386N50</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PartyRole" type="PartyRole" minOccurs="1" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PartyRole</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The role of the party in the transaction.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">ISSUER</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PartyType" type="PartyType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PartyType</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Type of party based on legal structure.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">SOVEREIGN</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PartyRating" type="RatingGroup" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PartyRating</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The credit rating assigned to the party.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">AA+</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--Issuance Definition-->
	<xs:complexType name="Issuance">
		<xs:sequence>
			<xs:element name="IssuanceType" type="IssuanceType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">IssuanceType</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Specifies whether a issuance is a programme issuance or standalone issuance.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">STANDALONE</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IssuanceDescription" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">IssuanceDescription</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Free text description of the offering.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">Issue of €20,000,000 0.00 per cent. due 22 June 2031 extendible up to 22 June 2026 and registered in a distributed ledger technology (DLT) platform.
</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DealIdentifier" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">DealIdentifier</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Identifier assigned to the deal by the issuer.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">DOC-1000</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Programme" type="Programme" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Programme</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Identifier and description of the programme.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">PGM-2025-1000</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GlobalNoteIdentifier" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">GlobalNoteIdentifier</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Identifier assigned to the global note.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">GN-2025-1</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReOpen" type="xs:boolean" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Issue</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indication that this issuance has the same terms and conditions as an existing note or programme and may be fungible with existing notes.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">false</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Fungible" type="Fungible" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Fungible</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indicator, date and security identifier of the fungible parent issue.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PrivatePlacement" type="PrivatePlacementProvision" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PrivatePlacement</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">A non-public issuance offered to private persons or institutional investors.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecifiedDenomination" type="Amount" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SpecifiedDenomination</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Specifies the unit value, par or face value of each bond that sets the minimum amount at which the note may be purchased.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">5000</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinimumDenomination" type="Amount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">MinimumDenomination</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Specifies the minimum per unit amount that can be purchased at one time.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">100000</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaximumDenomination" type="Amount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">MaximumDenomination</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Specifies the maximum per unit amount that can be purchased at one time.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">200000</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IntegralMultiples" type="Amount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">IntegralMultiples</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Smallest amount by which the minimum denomination can be increased.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">5000</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CalculationAmount" type="Amount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">CalculationAmount</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The amount used for calculation of interest and redemption amounts.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">10000000</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InitialAggregateAmount" type="Amount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">InitialAggregateAmount</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Initial issued amount before additional tranches or increases.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">10000000</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TotalAggregateAmount" type="Amount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">TotalAggregateAmount</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Total amount issued including all tranches, series and classes.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">20000000</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TotalOutstandingAmount" type="Amount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">TotalOutstandingAmount</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Total amount still outstanding and not redeemed.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">20000000</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaximumProgrammeAmount" type="Amount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">MaximumProgrammeAmount</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Maximum amount allowed under the programme.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">500000000</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaximumAmount" type="Amount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">MaximumAmount</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Maximum amount allowed under this issuance.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">100000000</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ChangeOfInterestPaymentBasis" type="ChangeOfInterestPaymentBasis" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ChangeOfInterestPaymentBasis</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Defines the type of change in the interest payment method and the date the change becomes effective</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">FIXED_TO_FLOAT 2028-02-25</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpecifiedCurrency" type="ISOCurrencyCode" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SpecifiedCurrency</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Currency of the nominal value of the issuance.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">EUR</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PaymentCurrency" type="ISOCurrencyCode" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PaymentCurrency</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Currency for interest payments. Only if payment currency differs from Specified Currency.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">GBP</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SettlementCurrency" type="ISOCurrencyCode" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SettlementCurrency</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Currency for settlement if settlement currency differs from Specified Currency.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">USD</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PricingDate" type="ISODate" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PricingDate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The date the transaction is priced. Also referred to as trade date for private placements.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">2025-11-19</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IssueDate" type="ISODate" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">IssueDate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Date when the note legally comes into existence separate from the closing date that may be later when securities are delivered or the date when a TAP becomes effective.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">2025-11-19</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SettlementDate" type="ISODate" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SettlementDate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">When investors receive notes in exchange for the issuer receiving net proceeds.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">2025-11-25</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ClosingDate" type="ISODate" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ClosingDate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">When securities are delivered to the underwriter.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">2025-11-18</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CutOffDate" type="ISODate" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">CutOffDate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Final date in the review period as in the case of an audit or issuer notice.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">2025-11-01</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IssuePrice" type="Price" minOccurs="0" maxOccurs="1">
