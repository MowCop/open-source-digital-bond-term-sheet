				</xs:annotation>
			</xs:element>
			<xs:element name="Class" type="Class" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Class</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Data group of elements to define classes of multiple notes of similar characteristics under a single issuance.</xs:documentation>
