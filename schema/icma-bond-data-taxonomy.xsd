					<xs:documentation source="Name" xml:lang="EN">ExchangeableNoticeDays</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Number of days before a note is exchangeable.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PrivatePlacementProvision">
		<xs:sequence>
			<xs:element name="PrivatePlacement" type="xs:boolean" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PrivatePlacement</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indicator (true/false) that the issuance is a private placement.</xs:documentation>
