				</xs:annotation>
			</xs:element>
			<xs:element name="Jurisdiction" type="ISOCountryCode" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Jurisdiction</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Jurisdiction where the private placement rule applies.</xs:documentation>
