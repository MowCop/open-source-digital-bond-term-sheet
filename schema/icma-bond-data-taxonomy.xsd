				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">BusinessDayConvention</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Specifies the method that adjusts payment and interest calculation periods.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">FOLLOWING, UNADJUSTED</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BusinessDayCenter" type="BusinessDayCalendar" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">BusinessDayCenter</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indicates the financial center or country calendar used to validate a business day for payments or interest calculations.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">T2</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Optionality" type="OptionType" minOccurs="0" maxOccurs="3">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Optionality</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indicates if the note is subject to a call or put option by the holder or issuer.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">CALL</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ForeignExchangeRateProvision" type="ForeignExchangeRateProvision" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ForeignExchangeRateProvision</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indicates if the note is subject to payments or redemption in a foreign currency and how the exchange rate is determined.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">EUR/USD</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProductClassification" type="ProductClassification" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">InstrumentCategory</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Custom category as defined through a separate xsd provided by the issuer.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LinkedProducts" type="LinkedProducts" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">InstrumentCategory</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Custom category as defined through a separate xsd provided by the issuer.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DLTBondIndicator" type="xs:boolean" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">DLTBondIndicator</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indication of whether the bond is issued on a distributed ledger. See also ICMA FAQs on DLT and blockchain in bond markets. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ESGLabel" type="ESGLabel" minOccurs="0" maxOccurs="4">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ESGLabel</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Securities that are aligned with ICMA principles or other relevant standards.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">GREEN</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SukukShariahCompliantIndicator" type="xs:boolean" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SukukShariahCompliantIndicator</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Securities that comply with Sharia principles.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">false</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UnderlyingProducts" type="Product" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">UnderlyingProducts</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Reference to any underlying products.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--PartyGroup Definition-->
	<xs:complexType name="PartyGroup">
		<xs:sequence>
			<xs:element name="Party" type="Party" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Party</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The name, LEI and other details of the party.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">Issuer, Guarantor, Registrar.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--Rating Definition-->
	<xs:complexType name="Rating">
		<xs:sequence>
			<xs:element name="RatingAgency" type="RatingAgency" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">RatingAgency</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Ratings Agency means Fitch Ratings Limited, Moody's Investors Service, Limited or SandP Global Ratings Europe Limited or any other statistical ratings organisation which rates the Issuer's debt securities.
</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">FITCH</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RatingValue" type="RatingValue" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">RatingValue</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Rating value assigned by the ratings agency.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">AAA</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RatingOutlook" type="RatingOutlook" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">RatingOutlook</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indication that a rating may be raised, lowered or is stable.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">STABLE</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="RatingValue">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">RatingValue</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Rating value assigned by the ratings agency.</xs:documentation>
			<xs:documentation source="Example" xml:lang="EN">AAA</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
		</xs:restriction>
	</xs:simpleType>
	<!--Rating Group-->
	<xs:complexType name="RatingGroup">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">RatingGroup</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Data element group of one or more ratings assigned by rating agencies to an entity or security.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element name="Rating" type="Rating" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Rating</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Rating agency and rating values assigned to the issuer or note.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Unrated" type="xs:boolean" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Unrated</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">No agency has a rating on the note.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<!--Security Definition-->
	<xs:complexType name="Security">
		<xs:sequence>
			<xs:element name="Identifier" type="SecurityIdentifier" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SecurityIdentifier</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">An identifier assigned to a security as defined by the service provider of the identifier such as ISIN and CUSIP.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">FR0015510310</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Ticker" type="SecurityTicker" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Ticker</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The ticker of the security used to price the note, e.g. DBR.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Maturity" type="Maturity" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Maturity</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Defines the type of maturity that describes the final redemption date of the security.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">2033-12-20</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InterestRate" type="xs:decimal" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">InterestRate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Rate of interest used to calculate coupon payments.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">4.5</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Price" type="PriceYieldDiscount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Price</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Price of the security in terms of percent, yield, discount.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">98.5</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--Security Identifier Definition-->
	<xs:complexType name="SecurityIdentifier">
		<xs:sequence>
			<xs:sequence>
				<xs:element name="ISIN" type="ISINOct2015Identifier" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">ISIN</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">The International Securities Identification Number assigned to the security.</xs:documentation>
						<xs:documentation source="Example" xml:lang="EN">FR0015510310</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="CUSIP" type="CUSIPIdentifier" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">CUSIP</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">Committee on Uniform Securities and Identification Procedures (CUSIP) number assigned to the security.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="FIGI" type="FIGIIdentifier" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">FIGI</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">Financial Instrument Global Identifier number assigned to the security.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="SEDOL" type="SEDOLIdentifier" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">SEDOL</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">Stock Exchange Daily Official List (SEDOL) number assigned to the security.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="COMMON_CODE" type="COMMON_CODEIdentifier" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">COMMON_CODE</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">A Common Code is a specific type of identifier issued by Clearstream and Euroclear to refer to a security.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="WKN" type="WKNIdentifier" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">WKNIdentifier</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">WKN, Wertpapierkennnummer is a German securities identifier.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="DTI" type="DTI2021Identifier" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">DTI</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">The Digital Token Identifier (DTI) assigned to the security.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="CMU" type="xs:string" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">CMU</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">Hong Kong Central Moneymarkets Unit identifier assigned to a security.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="VALOR" type="ValorenIdentifier" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">VALOR</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">Valoren number assigned to the security.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="CURP" type="CURPIdentifier" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">CURP</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">Mexico security identifier, Clave Única de Registro de Población, (CURP) assigned to the security.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="TEMPORARY_ISIN" type="xs:string" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">TEMPORARY_ISIN</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">Temporary ISIN assigned to a note, as in the case of a TAP or reopening, that will later become fungible and converted to the partent ISIN.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="TEMPORARY_CUSIP" type="xs:string" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">TEMPORARY_CUSIP</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">Temporary CUSIP assigned to a note, as in the case of a TAP or reopening, that will later become fungible and converted to the partent CUSIP.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="TEMPORARY_COMMON_CODE" type="xs:string" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">TEMPORARY_COMMON_CODE</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">Temporary Common Code assigned to a note, as in the case of a TAP or reopening, that will later become fungible and converted to the partent Common Code.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="SeriesIdentifier" type="xs:string" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">SeriesIdentifier</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">An identifier assigned by the issuer to a note under a programme with multiple series.</xs:documentation>
						<xs:documentation source="Example" xml:lang="EN">287</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="TrancheIdentifier" type="xs:string" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">TrancheIdentifier</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">An identifier assigned by the issuer to a note under a programme with multiple tranches.</xs:documentation>
						<xs:documentation source="Example" xml:lang="EN">2</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="ClassIdentifier" type="xs:string" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">ClassIdentifier</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">An identifier assigned by the issuer to a note under a programme with multiple classes.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="STEPIdentifier" type="xs:string" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">STEPIdentifier</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">Identifier that indicates the security is compliant with the ECB Short Term European Programme standards and documentation.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="OtherIdentifier" type="OtherIdentifier" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation source="Name" xml:lang="EN">OtherIdentifier</xs:documentation>
						<xs:documentation source="Definition" xml:lang="EN">Identifier and schema other than the predefine identifier types.</xs:documentation>
						<xs:documentation source="Example" xml:lang="EN">INE002A01018</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:sequence>
	</xs:complexType>
	<!--Security Ticker Definition-->
	<xs:complexType name="SecurityTicker">
		<xs:sequence>
			<xs:element name="Ticker" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Ticker</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">A short three or four alpha-numeric string that describes the security.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">DBR</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Source" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Source</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The organisation or system that is the source of the ticker identifier.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN"/>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--Price Definition-->
	<xs:complexType name="Price">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">Price</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Price type and decimal value that can represent a value, rate or percentage.</xs:documentation>
			<xs:documentation source="Example" xml:lang="EN">Price, 97.75</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Value" type="xs:decimal" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Value</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">A decimal value that can represent a value, rate or percentage.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">97.75</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PriceType" type="PriceType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PriceType</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">A price type enumeration (PERCENT, ABSOLUTE, SPREAD, BASIS_POINT) that identified how to interpret the price value element.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">PERCENT</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--Price Definition for Price, Yield or Discount-->
	<xs:complexType name="PriceYieldDiscount">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">PriceYieldDiscount</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">A complex type that includes elements for the price, yield and discount.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Price" type="Price" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Price</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">A decimal value that can represent a value, rate or percentage.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">97.75</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Yield" type="Price" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Yield</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">A value that represents the yield on an asset.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">2.5</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Discount" type="Price" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Discount</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">A value that represents the discount of an asset.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">.23</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BenchmarkSecurity" type="Security" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">BenchmarkSecurity</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Underlying reference security on which the price, yield or discount are calculated.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BenchmarkIndex" type="InterestRateBenchmark" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">BenchmarkIndex</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Underlying reference index on which the price, yield or discount are calculated.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">EONA</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SpreadToBenchmark" type="Price" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SpreadToBenchmark</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Difference in price or yield between the reoffer price and the benchmark security price.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">280.80</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--Accrued Interest Definition-->
	<xs:complexType name="AccruedInterest">
		<xs:sequence>
			<xs:element name="Date" type="ISODate">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Date</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Determination date (as of date) used to calculate accrued interest.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">2026-02-25</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Days" type="xs:integer">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Days</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Number of days used to calculated accrued interest.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">120</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InterestAmount" type="xs:decimal">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">InterestAmount</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Accrued interest amount.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">2026-02-25</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--Transaction Proceeds Definition-->
	<xs:complexType name="Proceeds">
		<xs:sequence>
			<xs:element name="Gross" type="Amount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Gross</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Amount due to issuer before costs, fees and taxes.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Net" type="Amount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Net</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Amount due to issuer after costs, fees and taxes.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AccruedInterest" type="Amount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">AccruedInterest</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Accumulated income calculated from the interest commencement date or trade date to the settlement date.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NetIncludingAccruedInterest" type="Amount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">NetIncludingAccruedInterest</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Net amount plus accrued interest from the sale of the notes.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ProceedsCurrency" type="ISOCurrencyCode" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ProceedsCurrency</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Currency of the cash paid to the issuer from sale of the notes.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">EUR</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UseOfProceeds" type="UseOfProceeds" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">UseOfProceeds</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Attributes and codes that describe the issuers use of proceeds from the sale of the notes.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--Market Listing Definition-->
	<xs:complexType name="Listing">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">Listing</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Indication that the note will be listed and on which venues.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Listed" type="xs:boolean" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Listed</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indication true/false if the security is listed on an exchange.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">true</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ListingVenue" type="ListingVenue" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ListingVenue</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The exchange or platform where the notes will be listed for trading.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">XLUX</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ListingVenue">
		<xs:sequence>
			<xs:element name="MIC" type="MarketIdentifierCode" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">MarketIdentifierCode</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Market Identifier Code in accordance with ISO 10383</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">XLUX</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Market" type="ListingMarket" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Listing</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Listing Market from the predefined list attached to this document.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">LUXEMBOURG_STOCK_EXCHANGE</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MarketName" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">MarketDescription</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Listing market name.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">LUXEMBOURG STOCK EXCHANGE</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MarketAlternateCode" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">MarketAlternateCode</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Alternate code for the listing market.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">LGX</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MarketType" type="ListingMarketType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">MarketType</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The listing market type is a code associated with the characteristics of the trading venue where the security is initially admitted to trading.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">RMKT</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<!--Interest Payment Definition-->
	<xs:complexType name="InterestPayment">
		<xs:sequence>
			<xs:element name="IsdaDetermination" type="IsdaDeterminationVersion" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">IsdaDetermination</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">If applicable the vesion of ISDA Determinations.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">2006</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InterestType" type="InterestType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">InterestType</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Type of interest payment (e.g. Fixed, Floating, Zero coupon). May also refer to dividend in other jurisdictions.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">FIXED</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FixedRatePayment" type="FixedRatePayment" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">FixedRatePayment</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Attributes that define fixed rate payments, frequency and day count methods.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FloatingRatePayment" type="FloatingRatePayment" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">FloatingRatePayment</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Attributes that define variable rate payments, frequency and day count methods.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ZeroCoupon" type="ZeroCoupon" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ZeroCoupon</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Attributes that define notes without coupon payments.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ResetSchedule" type="ResetSchedule" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ResetSchedule</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">List of dates when the note's interest rate is reset.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MinimumRate" type="xs:decimal" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">MinimumRate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Minimum rate allowed on the note.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaximumRate" type="xs:decimal" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">MaximumRate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Maximum rate allowed on the note.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="IssuanceDocumentation">
		<xs:sequence>
			<xs:element name="DocumentDetail" type="DocumentDetail" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">DocumentDetail</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">List of documents associated with the issuance.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DocumentDetail">
		<xs:sequence>
			<xs:element name="DocumentName" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">DocumentationName</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Name of offer document, including any supplements, red herrings. </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DocumentDate" type="ISODate" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">DocumentationDate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Offer document/supplement date.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DocumentLink" type="xs:anyURI" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">DocumentationLink</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Web link to relevant document.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DocumentId" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">DocumentId</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Custom document identifier assigned by the creator of the XML document.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">5378-1</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DigitalDocumentIdentifier" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">DOI</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Digital document identifier</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">12.1018/T0021-9258(11)52355-7</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DocumentVersion" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">DocumentVersion</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Custom version identifier assigned by document creator.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">1.01</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="InterestRateBenchmark">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">InterestRateBenchmark</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Underlying reference rate on which the periodic interest payments are calculated.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="BenchmarkCode" type="InterestRateBenchmarkCode" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Definition" xml:lang="EN">The code of the underlying security used to define the reference rate on which the periodic interest payments are calculated.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">EONA</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BenchmarkName" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Definition" xml:lang="EN">Common name of the underlying security used as the reference rate on which periodic interest payments are calculated.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">Euro Overnight Index Average (EONIA)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Currency" type="ISOCurrencyCode" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Currency</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Currency of the benchmark.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">GBP</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Source" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Source</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The organisation or system that is the source of the code.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Term" type="Term" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Term</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Term of the index/benchmark. Only required when term period defined. The term shall be expressed as an integer referring to a term period of days, weeks, months or years (as cited under Term Period).</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="TaxonomyCode">
		<xs:sequence>
			<xs:element name="Date" type="ISODate" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Date</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Date when code is assigned.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">2026-02-25</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Identifier" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Identifier</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Identifer code, id or string.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">DBFTFR</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SchemaSource" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Source</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Identifier of the taxonomy source, CFI or other.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">CFI</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="FeeWithAllocation">
		<xs:sequence>
			<xs:element name="Percentage" type="xs:decimal" minOccurs="0" maxOccurs="1">
			</xs:element>
			<xs:element name="FeeAllocationType" type="FeeAllocationType" minOccurs="0" maxOccurs="1">
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DateRange">
		<xs:sequence>
			<xs:element name="StartDate" type="FixedOrRelativeDate" minOccurs="0" maxOccurs="1">
			</xs:element>
			<xs:element name="EndDate" type="FixedOrRelativeDate" minOccurs="0" maxOccurs="1">
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="FixedOrRelativeDate">
		<xs:choice>
			<xs:element name="Date" type="ISODate" minOccurs="0" maxOccurs="1">
			</xs:element>
			<xs:element name="ReferenceDate" type="xs:string" minOccurs="0" maxOccurs="1">
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="SecurityIdentifierList">
		<xs:sequence>
			<xs:element name="SecurityIdentifier" type="SecurityIdentifier" minOccurs="0" maxOccurs="unbounded">
				</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PaymentDatesAndAmounts">
		<xs:sequence>
			<xs:element name="InterestPaymentFrequency" type="InterestPaymentFrequency" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">InterestPaymentFrequency</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The term period of payments.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">ANNUALLY</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PayableDate" type="PayableDayAndMonth" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PayableDayAndMonth</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The day and month during the year when interest payments are scheduled.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">3-11</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FirstPayment" type="PaymentDateAndAmount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">FirstPayment</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Date and amount of first payment.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">SHORT 2026-03-11 2100</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LastPayment" type="PaymentDateAndAmount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">LastPayment</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Date and amount of last payment.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">LONG 2033-05-11 2100</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ScheduledPaymentDates" type="PaymentSchedule" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ScheduledPaymentDates</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">List of interest payment dates.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">2027-03-11,2028-03-11,2029-03-11</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DeterminationDates" type="ISODate" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">DeterminationDates</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Interest payment dates excluding issue date and maturity date.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">2027-05-11</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PaymentSchedule">
		<xs:sequence>
			<xs:element name="ScheduledPayment" type="PaymentDateAndAmount" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ScheduledPayment</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">List of schedule payment dates and amounts.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PaymentDateAndAmount">
		<xs:sequence>
			<xs:element name="PaymentDate" type="ISODate" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PaymentDate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Date of a payment e.g. coupon, paydown, fee.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BrokenDateProvision" type="BrokenDateProvision" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">BrokenDateProvision</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Attributes that define a non-standard interest period.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Amount" type="Amount" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PayableDayAndMonth">
		<xs:sequence>
			<xs:element name="Day" minOccurs="1" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="xs:integer">
						<xs:minInclusive value="1"/>
						<xs:maxInclusive value="31"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Month" minOccurs="1" maxOccurs="1">
				<xs:simpleType>
					<xs:restriction base="xs:integer">
						<xs:minInclusive value="1"/>
						<xs:maxInclusive value="12"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="FixedRatePayment">
		<xs:sequence>
			<xs:element name="InterestRate" type="xs:decimal" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">InterestRate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Rate of fixed interest payments.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InterestPayments" type="PaymentDatesAndAmounts" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">InterestPayments</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">List of fixed rate interest payment dates and amounts.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="InterestCommencementDate" type="ISODate" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">InterestCommencementDate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Initial date for calculation of interest payments.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DayCountFraction" type="DayCountFraction" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">DayCountFraction</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Specifies the method that determines the number of days in a period that is used to compute accruing interest of the product.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">ACT/360</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="BusinessDayConvention" type="BusinessDayConvention" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">BusinessDayConvention</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Specifies the method that adjusts payment and interest calculation periods.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">FOLLOWING, UNADJUSTED</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RatingStepUpStepDown" type="Applicability" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">RatingStepUpStepDown</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indication that the note is subject to rate adjustments due to changes in credit rating.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="StepUpStepDownMargin" type="xs:decimal" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">StepUpStepDownMargin</xs:documentation>
