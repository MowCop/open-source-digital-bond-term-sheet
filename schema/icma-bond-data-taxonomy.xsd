					<xs:documentation source="Example" xml:lang="EN">99.875</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IndicationOfYield" type="Price" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">IndicationOfYield</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The yield of the security based on the issue price.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">3.98</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReofferPrice" type="Price" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ReofferPrice</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The price defined as such in the Invitation to Managers or, if none, the price below which the Managers were told they should not reoffer the securities until notified otherwise.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">99.9</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReofferYield" type="Price" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ReofferYield</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The yield of the security based on the reoffer price.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">3.91</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Benchmark" type="Security" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Benchmark</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The benchmark security used as a reference to calculate the price of the note being issued.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">FR0015510312</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReofferSpreadToBenchmark" type="Price" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ReofferSpreadToBenchmark</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Difference in price or yield between the reoffer price and the benchmark security price.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">279.50</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MidSwapRate" type="SwapRateDefinition" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">MidSwapRate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Midpoint or average of the bid and offer swap rate, and the tenor used as a reference to the issue price of the security.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ReofferSpreadtoMidSwapRate" type="Price" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ReofferSpreadtoMidSwapRate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Difference in price/yield between the reoffer price/yield based on the mid swap rate.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">100.50</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Fee" type="FeeWithAllocation" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">FeeWithAllocation</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Fees payable to managers/dealers expressed as a percentage of nominal amount. Also referred to as commissions.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Delivery" type="DeliveryType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Delivery</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Type of securities settlement delivery method, DVP or Free of Payment.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">DVP</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Proceeds" type="Proceeds" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Proceeds</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The proceeds received by the issuer from the sale of the securities.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">302577998000</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AllIn" type="PriceYieldDiscount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">AllInPYD</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The price, yield or discount after deducting any costs to the issuer.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">109.75</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Listing" type="Listing" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Listing</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indication that the note will be listed and on which venues.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CashClearingSystem" type="SystemIdentifier" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">CashClearingSystem</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Specifies the system which plays a role in the cash clearing.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">T2</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SecuritiesClearingSystem" type="SystemIdentifier" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SecuritiesClearingSystem</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Specifies the system which plays a role in the clearing of securities.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">CBF</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SecuritiesSettlementSystem" type="SystemIdentifier" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SecuritiesSettlementSystem</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Specifies the system which plays a role in settlement of securities.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">CBF</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CashSettlementSystem" type="SystemIdentifier" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">CashSettlementSystem</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Specifies the system which plays a role in the settlement of cash.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">T2</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PlaceOfDeposit" type="PlaceOfDepositSystem" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PlaceOfDeposit</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Depository or platform where securities are held as in an (I)CSD.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">CBL</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DLTPlatform" type="DltPlatformOperationalInformation" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">DLTPlatform</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Specifies the details of the distributed ledger technology (DLT) platforms used for issuance, registration, settlement and other purposes.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MethodOfDistribution" type="Distribution" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">MethodOfDistribution</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Identifies the issuance as being syndicated or non-syndicated.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">Syndicated</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GoverningLaw" type="GoverningLaw" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">GoverningLaw</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The law of the specified country and possible subdivision that governs the issuance of the security.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">GB-ENG</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Expenses" type="Amount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Expenses</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Description of fees, commissions or other costs.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Tax" type="Tax" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Tax</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Details on the tax obligations of the issuer or bond holder.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="IssuanceDocumentation" type="IssuanceDocumentation" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Documentation</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Prospectus or other documents related to the issuance.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SellingRestrictions" type="SellingRestrictions" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SellingRestrictions</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Provision of the offering that restricts to whom, during what period of time, and/or in what jurisdictions the bond may be sold.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TargetMarket" type="ManufacturerTargetMarket" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ManufacturerTargetMarket</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The target market assessment in respect of the notes and which channels for distribution of the notes are appropriate.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="NegativePledge" type="Applicability" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">NegativePledge</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Provision that indicates the issuer will not create security over its assets in favour of other creditors unless equivalent security is simultaneously granted to the bondholders.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">NA</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GrossUp" type="Applicability" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">GrossUp</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">An indication of any tax provision that may affect the payment obligations of the issuer.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">NA</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CrossDefault" type="Applicability" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">CrossDefault</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">An indication that a provision exists related to the default of another security affecting the issued security. </xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">NA</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubstitutionOrVariation" type="Applicability" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SubstitutionOrVariation</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indication of whether the terms and conditions of the note provide for a substitution or variation.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">NA</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Redemption" type="RedemptionProvision" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Redemption</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The method, date and calculations that are used to determine redemption of the bond's principal and interest.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="YieldToCall" type="Price" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">YieldToCall</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The yield as calculated to the specified or earliest call date.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RecordDate" type="AdjustedDate" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">RecordDate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The number of days prior to payment date to determine holders of record.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Events" type="Event" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Events</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">List of events and event codes that have taken place or are scheduled.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SubstitutionAndExchangeProvision" type="SubstitutionAndExchangeProvision" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SubstitutionAndExchangeProvision</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indication if substitutions are allowed and which securities are eligible for substitution.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MREL_Ratio_Percentage" type="xs:decimal" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">MREL</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The Minimum Requirement for Own Funds and Eligible Liabilities (MREL) ratio expressed as a percentage.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AdditionalIssuanceInformation" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">AdditionalIssuanceInformation</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Free text field for the issuer to include additional issuance information.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN"/>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
