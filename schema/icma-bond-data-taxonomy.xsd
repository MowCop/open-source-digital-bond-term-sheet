	<xs:complexType name="GlobalNote">
		<xs:sequence>
			<xs:element name="GlobalNoteType" type="GlobalNoteType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">GlobalNoteType</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Type of Global Note; New Global Note or Classic Global Note.</xs:documentation>
