			<xs:element name="Identifier" type="PlatformIdentifier" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Identifier</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">One or more identifiers assigned to the platform that may include a MIC, LEI, DTI or custom identifier.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">DTI XC7KDF8R9</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SmartContract" type="SmartContract" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SmartContract</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Name and identifier of the smart contract used by the platform in reference to the token type and purpose of the platform.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">0xE9Ac9b7zf6DA4FcDK8BE49</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
