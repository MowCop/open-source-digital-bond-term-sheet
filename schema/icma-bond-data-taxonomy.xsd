				</xs:annotation>
			</xs:element>
			<xs:element name="MinRedemptionAmount" type="Amount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">MinRedemptionAmount</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Specified minimum amount or per calcuation amount if specified, to be redeemed by the issuer.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">1000</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="MaxRedemptionAmount" type="Amount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">MaxRedemptionAmount</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Specified maximum amount or per calcuation amount if specified, to be redeemed by the issuer.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">10000000</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RedemptionPrice" type="Price" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">RedemptionPrice</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Price paid by the issuer at redemption.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">100.00</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RedemptionPremium" type="Amount" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">RedemptionPremium</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Premium paid by the issuer at redemption.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">0</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FixingDate" type="ISODate" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">FixingDate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Date(s) when the redemption price is determined.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">2033-03-04</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OptionalRedemptionDate" type="ISODate" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">OptionalRedemptionDate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Date(s) when the issuer or investor may redeem notes.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">2027-03-04</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FinalRedemptionDate" type="ISODate" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">FinalRedemptionDate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Last date when the issuer or investor may redeem notes.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">2033-03-04</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OptionalRedemptionPeriod" type="OptionalRedemptionPeriod" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">OptionalRedemptionPeriod</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Period of time when an option to redeem the notes is allowed.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">5Y</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OptionalRedemptionType" type="OptionalRedemptionType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">OptionalRedemptionType</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indicates whether securities or cash or both may be redeemed.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RedemptionPaymentBasis" type="RedemptionPaymentBasis" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">RedemptionPaymentBasis</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Definition of how redemption amount is determined and provisions for determining redemption.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">PAR, PARTLY_ PAID, AMORTISING, etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OptionalRedemptionPeriod">
		<xs:sequence>
			<xs:element name="OptionalRedemptionDateRange" type="DateRange" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">OptionalRedemptionDateRange</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Start and end date during which optional redemption is available.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">Start Date: 2025-02-03, End Date: 2033-02-03</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="OptionalRedemptionAmount" type="Amount" minOccurs="1" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">OptionalRedemptionAmount</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Amount of the optional redemption.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">2000000000</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StatusOfNote">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">StatusOfNote</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Captures information relating to the seniority, subordinated, secured and preferred status of the note.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Seniority" type="SeniorityCode" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Seniority</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indication if the note is ranked as senior or junior.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">SENIOR</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Subordinated" type="SubordinatedCode" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Subordinated</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indication if the note is subordinated or unsubordinated.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">UNSUBORDINATED</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Secured" type="SecuredCode" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Secured</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indication if the note is secured or unsecured.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">SECURED</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Preferred" type="PreferredCode" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Preferred</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indication if the note is preferred or non-preferred.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">NON_PREFERRED</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AdditionalStatusOfNote" type="AdditionalStatusOfNoteCode" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">AdditionalStatusOfNoteCode</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indication of the note's capital structure, Tier1 Capital, Covered, etc.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Event">
		<xs:sequence>
			<xs:element name="EventCode" type="EventType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">EventCode</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Code to indicate contingency or viability event.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EventDescription" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">EventDescription</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Custom description and details of the event.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="EventDate" type="ISODate" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">EventCode</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Date of the event.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="SellingRestrictions">
		<xs:sequence>
			<xs:element name="TEFRA" type="Tefra" minOccurs="0" maxOccurs="3">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">TEFRA</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Codes for Tax Equity and Fiscal Responsibility Act of 1982.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="REGS" type="RegS" minOccurs="0" maxOccurs="4">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">REGS</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Codes for Regulation S of the U.S. Securities Act.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RULE144A" type="xs:boolean" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Rule144A</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">True/False indicator if the note complies with U.S. Rule 144A.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="SEC_Registered" type="xs:boolean" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">SEC_Registered</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">True/False indicator if the note is SEC Registered.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Rule3C7" type="xs:boolean" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Rule3C7</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">True/False indicator if the note complies with Rule 3c7 exemption.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Accredited_Investor" type="xs:boolean" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Rule3C7</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">True/False indicator that the note is only available to accredited investors as defined by the governing jurisdiction.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RiskLinkedSecurity" type="xs:boolean" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Rule3C7</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">True/False indicator if the note is a risk linked security.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="PRIIPsRestriction" type="PRIIPsRestriction" minOccurs="0" maxOccurs="4">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PRIIPs</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Any prohibition of sales to EEA and/or UK retail investors pursuant to the EEA and/or UK PRIIPs Regulation.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">NO_EEA</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CCIRestriction" type="CCIRestriction" minOccurs="0" maxOccurs="4">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">CCIRestriction</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">UK Consumer Composite Investments (CCI) regime.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">APPLICABLE</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CountryRestrictions" type="ISOCountryCode" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">CountryRestrictions</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">List of country codes with selling restrictions on the note.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">EU</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="CurrencyRestrictions" type="ISOCurrencyCode" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">CurrencyRestrictions</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">List of currency codes restrictions.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">EUR</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AdditionalSellingRestrictions" type="xs:string" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">AdditionalSellingRestrictions</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Free text field to describe additional selling restrictions.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Tefra">
		<xs:sequence>
			<xs:element name="TefraCode" type="TefraCode" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">TefraCode</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Code to indicate US Tax Equity and Fiscal Responsibility Act of 1982</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">TEFRA_C</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TefraExchangeDate" type="ISODate" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">TefraExchangeDate</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Date when security is exchangeable from temporary to permanent form.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">2026-01-15</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AdditionalNotes" type="xs:string" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RegS">
		<xs:sequence>
			<xs:element name="RegSCode" type="RegSCode" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">RegSCode</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Code to indicate US Regulation S exemption from registration.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">REGS_CAT1</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AdditionalNotes" type="xs:string" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="UseOfProceeds">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">UseOfProceeds</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Codes and text that describes how the proceeds from the sale of the bond will be allocated by the issuer to projects or other initiatives.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="UseOfProceedsPrimaryCategory" type="UseOfProceedsPrimaryCategory" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">UseOfProceedsPrimaryCategory</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Code used to describe the primary use of the proceeds.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">CPUR</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UseOfProceedsSubCategory" type="UseOfProceedsSubCategory" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">UseOfProceedsSubCategory</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Code used to describe a subcategory of the use of the proceeds.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">CPUR</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="UseOfProceedsDescription" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">UseOfProceedsDescription</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Describes how the proceeds from the sale of the bond will be allocated by the issuer to projects or other initiatives.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Tax">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">Tax</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Fields to define applicable country tax codes.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="TaxCode" type="TaxCode" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">TaxCode</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The tax code from the BDT predefined lists.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">WITHHOLDING</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TaxProcessingEntity" type="Party" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">TaxProcessingEntity</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">The entity responsible for processing tax calculations and reporting.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">See Party Definition</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TaxDescription" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">TaxDescription</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Supplements the description of tax code or tax provisions.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="WithHoldingTaxCountry" type="ISOCountryCode" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">WithHoldingTaxCountry</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Country code of the tax country jurisdiction.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">LU</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="FormOfNote">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">FormOfNote</xs:documentation>
			<xs:documentation source="Definition" xml:lang="EN">Indication of the notes physical and legal form.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="PhysicalFormOfNote" type="PhysicalFormOfNote" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">PhysicalFormOfNote</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indication of the physical form as in material or electronic.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">UNCERTIFICATED</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="LegalTitleFormOfNote" type="LegalTitleFormOfNote" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">LegalTitleFormOfNote</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indication of the legal form as in bearer or registered.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">REGISTERED</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="GlobalNote" type="GlobalNote" minOccurs="0" maxOccurs="1">
