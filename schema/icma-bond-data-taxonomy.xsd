				</xs:annotation>
			</xs:element>
			<xs:element name="ReferenceRegulation" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">ReferenceRegulation</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Regulation that defines the rules for private placement within the specified jurisdiction.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Distribution">
		<xs:annotation>
			<xs:documentation source="Name" xml:lang="EN">Distribution</xs:documentation>
