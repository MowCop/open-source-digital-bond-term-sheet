				</xs:annotation>
			</xs:element>
			<xs:element name="Auction" type="xs:boolean" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">Auction</xs:documentation>
