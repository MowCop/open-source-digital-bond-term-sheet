				</xs:annotation>
			</xs:element>
			<xs:element name="GlobalNoteIdentifier" type="xs:string" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation source="Name" xml:lang="EN">GlobalNoteIdentifier</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Identifier assigned to the global note.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">Global Note Document ID</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ExchangeableNoticeDays" type="xs:integer" minOccurs="0" maxOccurs="1">
