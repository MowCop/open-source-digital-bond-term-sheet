					<xs:documentation source="Name" xml:lang="EN">Confidential</xs:documentation>
					<xs:documentation source="Definition" xml:lang="EN">Indication if the issuance is confidential.</xs:documentation>
					<xs:documentation source="Example" xml:lang="EN">false</xs:documentation>
				</xs:annotation>
