xs:string">			<xs:enumeration value="ISSUER">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Issuer</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">The issuer is a legal entity that is creating and selling a security for the purpose of raising capital in exchange for shares in the entity or a debt owed by the entity to the holder.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="GUARANTOR">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Guarantor</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">An institution that guarantees the payment and obligations of an issuer's security offering.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="LEAD_MANAGER">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">LeadManager</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Institution hired by the issuer and responsible for structuring a primary offering of security.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="JOINT_LEAD_MANAGER">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">JointLeadManager</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Institutions that participate in the structuring, pricing and distribution of a new security jointly with other institutions.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="CO_MANAGER">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">CoManager</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Institutions that participate in the distribution of a new security jointly with other institutions.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="ARRANGER">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Arranger</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Alternative name for lead manager.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="PLACEMENT_AGENT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">PlacementAgent</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Firm assisting in the structuring and selling of new securities.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="FISCAL_AGENT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">FiscalAgent</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Firm that performs transaction and redemption services for an issuer.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="PRINCIPAL_PAYING_AGENT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">PrincipalPayingAgent</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Institution  or platform responsible for paying coupons and principal on a security.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="CALCULATION_AGENT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">CalculationAgent</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Agent responsible for determining interest rates, benchmarks and redemption details.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="STABILISATION_MANAGER">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">StabilisationManager</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Firm providing liquidity and price support associated with a new issue.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="TRUSTEE">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Trustee</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Institution with fiduciary responsibility to enforce the terms of the issuance on behalf of the bondholders.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="REGISTRAR">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Registrar</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Institution or platform acting as record keeper of holders of registered securities.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="CUSTODIAN">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Custodian</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Institution responsible for holding securities or other assets.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="CSD_ICSD">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Central Securities Depository</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Institution that provides safekeeping and registration of new securities.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="COLLATERAL_ADMINISTRATOR">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Collateral Administrator</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Institution responsible for reporting, compliance and management of collateral used in specialized asset pools.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="PLATFORM_OPERATOR">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">PlatformOperator</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Party responsible for maintaining the operations of the platform.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="DIRECT_PARTICIPANT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">DirectParticipant</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Participant that has permissible access to the platform and through which other investors must use to register tokens.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="DEPOSIT_BANK">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">DepositBank</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Institution that accepts and makes payments in connection with the issuance process or lifecycle of the security.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="CASH_TOKEN_MANAGER">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">CashTokenManager</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Service or platform that processes cash tokens on a DLT platform.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="GLOBAL_COORDINATOR">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">GlobalCoordinator</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Firm assisting in coordinating a global primary offering in a similar role as a joint lead manager.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="INFORMATION_AGENT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Information Agent</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Institution that reviews, manages and distributes offering documents and other materials to holders and other participants.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="JOINT_BOOKRUNNER">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">JointBookRunner</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Institutions that participate in the structuring, pricing and distribution of a new security jointly with other institutions.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="MARKET_PRACTICE_ADVISOR">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">MarketPracticeAdvisor</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Institution that advises issuer and managers in relation to the issuance of a new security on matters related to compliance and distribution.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="TRANSFER_AGENT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">TransferAgent</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Institution that maintains ownership records of bond holders and distributes payments and other information to bond holders.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="ISSUE_AGENT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">IssueAgent</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Institution appointed by the issuer to perform services in connection with the issuance of security including paying agent, transfer agent and more.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="LEGAL_ADVISOR">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">LegalAdvisor</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Advisor to the issuer or other parties on legal matters in the process of issuing a bond.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="LEGAL_COUNSEL">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">LegalCounsel</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Legal counsel to the issuer or other parties on legal matters in the process of issuing a bond.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="PAYING_AGENT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">PayingAgent</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Institution making payments of interest and principal to bond holders.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="SETTLEMENT_AGENT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">SettlementAgent</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Institution that facilitates the transfer of securities and cash in a transaction.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="DETERMINATION_AGENT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">DeterminationAgent</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Agent responsible for verifying terms and conditions, compliance, fixings and other factors.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="CONVERSION_AGENT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">ConversionAgent</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Agent responsible the conversion of securities when applicable.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="BILLING_AND_DELIVERY_AGENT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">BillingAgent</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Agent responsible to administer financial  and distribution of principal and interest.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="EXERCISE_AGENT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">ExerciseAgent</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Agent responsible exercising a optionality provisions of the issuance.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="EXCHANGE_AGENT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">ExchangeAgent</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Agent responsible the exchange or conversion of securities when applicable.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="LISTING_AGENT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">ListingAgent</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Agent acting as intermediary and advisor to ensure documentation and other requirements are met for the listing of securities on an exchange.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="AGGREGATION_AGENT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">AggregationAgent</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Agent that consolidates bonds into a single separate offering.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="AUDITOR">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Auditor</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Firm responsible for verifying the accuracy and completeness of financial statements, interest calculations, proceeds and valuation.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="UNDERWRITER">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Underwriter</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Firms that purchase securities from the issuer and resell the securities to investors.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="LODGING_AGENT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">LodgingAgent</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Institution or platform that provides lodgement services (i.e. services related to issuing, registration, custody and payment for securities) with the Central Moneymarkets Unit (CMU).</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="CENTRAL_ACCOUNT_KEEPER">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">CentralAccountKeeper</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Institution that stores on a top-tier level, and facilitates transfers of, tokenized securities on behalf of clients and direct participants of the platform.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="TOKENISATION_MANAGER">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">TokenisationRegistrar</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Institution or platform that generates tokens and manages tokens representing securities, cash or other assets.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="CRYPTO_SECURITIES_REGISTRAR">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">CryptoSecuritiesRegistrar</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Institution or platform that performs registration of crypto assets, other service and are registered with BaFin under German Law.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="OTHER_PARTYROLE_TYPE">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">OtherPartyRoleType</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Any other party role that is not defined in the enumerations.</xs:documentation>				</xs:annotation>			</xs:enumeration>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="PartyType">		<xs:annotation>			<xs:documentation source="Name" xml:lang="EN">PartyType</xs:documentation>			<xs:documentation source="Definition" xml:lang="EN">Type or legal structure of the party.</xs:documentation>		</xs:annotation>		<xs:restriction id="PartyType" base="xs:string">			<xs:enumeration value="CORPORATION"/>			<xs:enumeration value="SUPRANATIONAL"/>			<xs:enumeration value="SOVEREIGN"/>			<xs:enumeration value="MUNICIPAL"/>			<xs:enumeration value="PROVINCE"/>			<xs:enumeration value="STATE"/>			<xs:enumeration value="COUNTY"/>			<xs:enumeration value="PARTNERSHIP"/>			<xs:enumeration value="FINANCIALINSTITUTION"/>			<xs:enumeration value="NATIONAL"/>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="RatingAgency">		<xs:union memberTypes="RatingAgencyList Other"/>	</xs:simpleType>	<xs:simpleType name="RatingAgencyList">		<xs:annotation>			<xs:documentation source="Name" xml:lang="EN">RatingAgencyList</xs:documentation>			<xs:documentation source="Definition" xml:lang="EN">Ratings Agency means Fitch Ratings Limited, Moody's Investors Service, Limited or SandP Global Ratings Europe Limited or any other statistical ratings organisation which rates the Issuer's debt securities.</xs:documentation>		</xs:annotation>		<xs:restriction id="RatingAgency" base="xs:string">			<xs:enumeration value="FITCH">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Fitch</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">FITCH Rating Agency</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="MOODYS">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Moodys</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">MOODYS Rating Agency</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="SNPG">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">StandardAndPoorsGlobal</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">S and P Global Ratings.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="DBRS">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">DBRS</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">DBRS Rating Agency</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="SCOPE">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">SCOPE</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Scope Ratings GmbH.</xs:documentation>				</xs:annotation>			</xs:enumeration>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="RatingOutlook">		<xs:restriction id="RatingOutlook" base="xs:string">			<xs:enumeration value="POSITIVE">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Positive</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">A Positive outlook indicates the rating may be raised.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="STABLE">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Stable</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Rating outlook that indicates the rating is unlikely to change.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="NEGATIVE">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Negative</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">A Negative outlook indicates the rating may be lowered.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="DEVELOPING">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Developing</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">The rating outlook indicates the rating is uncertain and may be raised, lowered or affirmed as defined by the rating agency.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="NOT_MEANINGFULL">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">NotMeaningFull</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">A Not Meaningful outlook indicates no outlook opinion.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="EVOLVING">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">EVOLVING</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">An Evolving outlook indicates the rating may be raised, lowered or affirmed as defined by the rating agency.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="NOT_APPLICABLE"/>		</xs:restriction>	</xs:simpleType>	<!-- Issuance Types-->	<xs:simpleType name="IssuanceType">		<xs:restriction id="IssuanceType" base="xs:string">			<xs:enumeration value="PROGRAMME">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Programme</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">A bond issuance platform, consisting of a base offer document and suite of master contracts, facilitating the issue of bonds through draw-downs.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="GLOBAL_NOTE">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">GlobalNote</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">A primary offer under a global note.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="STANDALONE">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Standalone</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">A primary offer not made under a programme.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="PROGRAMME_NOTE">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Program Note</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Issuance of a new note under an existing programme.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="TAP">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">TAP</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Indicates that this is a TAP or reopening where additional fungible notes are being offered.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="SERIES">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Series</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Issuance of a new note as a new series under an existing programme.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="TRANCHE">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Tranche</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Issuance of a new note as a new tranche under an existing programme.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="CLASS">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Class</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Issuance of a new note as a new class under an existing programme.</xs:documentation>				</xs:annotation>			</xs:enumeration>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="SeniorityCode">		<xs:union memberTypes="SeniorityCodeList Other"/>	</xs:simpleType>	<xs:simpleType name="SeniorityCodeList">		<xs:annotation>			<xs:documentation source="Name" xml:lang="EN">SeniorityCode</xs:documentation>			<xs:documentation source="Definition" xml:lang="EN">Highest level of debt indicates holders that will receive a priority payment above all other levels of seniority in case of default or liquidation.</xs:documentation>		</xs:annotation>		<xs:restriction id="SeniorityCode" base="xs:string">			<xs:enumeration value="SUPER_SENIOR">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">SuperSenior</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Senior debt indicates holders that will receive a priority payment above junior or subordinated bonds in case of default or liquidation.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="SENIOR">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Senior</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Senior debt indicates holders that will receive a priority payment above junior or subordinated bonds in case of default or liquidation. </xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="JUNIOR">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Junior</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Junior debt indicates holders that will receive payment below senior in case of default or liquidation.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="MEZZANINE">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Mezzanine</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Mezzanine debt indicates hybrid junior debt that will receive a payment below senior but above equity in case of default or liquidation.</xs:documentation>				</xs:annotation>			</xs:enumeration>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="SecuredCode">		<xs:annotation>			<xs:documentation source="Name" xml:lang="EN">SecuredCode</xs:documentation>			<xs:documentation source="Definition" xml:lang="EN">Indication if debt is secured.</xs:documentation>		</xs:annotation>		<xs:restriction id="SecuredCode" base="xs:string">			<xs:enumeration value="SECURED">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Secured</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Secured indicates that the debt includes pledged collateral.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="UNSECURED">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Unsecured</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Unsecured indicates that the debt does not include pledged collateral.</xs:documentation>				</xs:annotation>			</xs:enumeration>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="SubordinatedCode">		<xs:annotation>			<xs:documentation source="Name" xml:lang="EN">SubordinatedCode</xs:documentation>			<xs:documentation source="Definition" xml:lang="EN">Indication if debt is subordinated.</xs:documentation>		</xs:annotation>		<xs:restriction id="SubordinatedCode" base="xs:string">			<xs:enumeration value="SUBORDINATED">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Subordinated</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Subordinated indicates a class of bond holder that will receive payment after senior debt holders in the case of default or liquidation.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="UNSUBORDINATED">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Unsubordinated</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Unsubordinated indicates a class of bond holder that will receive payment as senior debt holders in the case of default or liquidation.</xs:documentation>				</xs:annotation>			</xs:enumeration>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="PreferredCode">		<xs:annotation>			<xs:documentation source="Name" xml:lang="EN">PreferredCode</xs:documentation>			<xs:documentation source="Definition" xml:lang="EN">Indication if debt is preferred.</xs:documentation>		</xs:annotation>		<xs:restriction id="PreferredCode" base="xs:string">			<xs:enumeration value="PREFERRED">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Preferred</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Preferred debt holders receive payment below senior debt holders but above common equity in the case of default or liquidation.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="NON_PREFERRED">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">NonPreferred</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Non-referred debt holders do not receive any payment priority above common equity in the case of default or liquidation.</xs:documentation>				</xs:annotation>			</xs:enumeration>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="AdditionalStatusOfNoteCode">		<xs:union memberTypes="AdditionalStatusOfNoteCodeList Other"/>	</xs:simpleType>	<xs:simpleType name="AdditionalStatusOfNoteCodeList">		<xs:annotation>			<xs:documentation source="Name" xml:lang="EN">AdditionalStatusOfNoteCode</xs:documentation>			<xs:documentation source="Definition" xml:lang="EN">Indication of the note capital structure.</xs:documentation>		</xs:annotation>		<xs:restriction id="AdditionalStatusOfNoteCode" base="xs:string">			<xs:enumeration value="TIER1CAPITAL">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Tier1Capital</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">High quality assets (common equity, retained earnings).</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="TIER2CAPITAL">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Tier2Capital</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Assets of lower quality than tier 1 capital.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="TIER3CAPITAL">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Tier3Capital</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Low quality assets (unsecured, subordinated debt).</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="BAIL-IN">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Bail-In</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Bail-in clause is included and applies to the note being issued.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="COVERED">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Covered</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Note that is secured by high quality assets.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="STRUCTURED_COVERED">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Structured Covered</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Note that is secured by hybrid or derivative securities.</xs:documentation>				</xs:annotation>			</xs:enumeration>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="PhysicalFormOfNote">		<xs:annotation>			<xs:documentation source="Name" xml:lang="EN">PhysicalFormOfNote</xs:documentation>			<xs:documentation source="Definition" xml:lang="EN">Whether Bearer, Registered, or other formats.</xs:documentation>		</xs:annotation>		<xs:restriction id="PhysicalFormOfNoteType" base="xs:string">			<xs:enumeration value="DEMATERIALISED">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Dematerialised</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Note is issued in digital or electronic form.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="UNCERTIFICATED">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Uncertificated</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">No physical certificate is issued for the note.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="CERTIFICATED">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Certificated</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Note is issued in physical certificate form.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="GLOBAL_NOTE_CERTIFICATE">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Global Note Certificate</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Note is issued in global note certificate form.</xs:documentation>				</xs:annotation>			</xs:enumeration>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="LegalTitleFormOfNote">		<xs:annotation>			<xs:documentation source="Name" xml:lang="EN">FormOfNote</xs:documentation>			<xs:documentation source="Definition" xml:lang="EN">Whether Bearer, Registered, or other formats.</xs:documentation>		</xs:annotation>		<xs:restriction id="LegalTitleFormOfNote" base="xs:string">			<xs:enumeration value="BEARER">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Bearer</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">A bearer bond indicates that ownership is determined by possession of a physical certificate or token.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="REGISTERED">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Registered</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">A registered bond is one where ownership details are held in a register by the issuer or an agent appointed by the issuer.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="DEMATERIALISED">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Dematerialised</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Note is issued in digital or electronic form.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="BOOK_ENTRY">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">BOOK_ENTRY</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Ownership is recorded in a system in electronic form.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="COLLECTIVE_DEBT_REGISTERED_CLAIM">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">COLLECTIVE_DEBT_REGISTERED_CLAIM</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Ownership is held by a group.</xs:documentation>				</xs:annotation>			</xs:enumeration>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="InterestType">		<xs:restriction id="InterestType" base="xs:string">			<xs:enumeration value="FIXED">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Fixed</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">A fixed rate indicates the interest rate does not change during the term of the bond or other period specified by the issuer.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="FLOATING">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Floating</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Interest payments vary depending on an underlying benchmark security or index.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="ZERO_COUPON">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">Zero Coupon</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Note does not pay periodic interest or interest at maturity but is priced at a discount to face value.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="INDEX_LINKED_INTEREST">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">INDEX_LINKED_INTEREST</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Interest payments vary depending on a reference index.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="RESET">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">RESET</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Interest payments are periodically modified based on a new rate as set out in the terms of the offering.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="VARIABLE">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">VARIABLE</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Interest payments vary depending on an underlying benchmark security or index.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="PAYMENT_IN_KIND">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">VARIABLE</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Payments are not made in cash but in additional notes.</xs:documentation>				</xs:annotation>			</xs:enumeration>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="DayCountFraction">		<xs:restriction id="DayCountFraction" base="xs:string">			<xs:enumeration value="ICMA_ACT/ACT"/>			<xs:enumeration value="ISDA_ACT/ACT"/>			<xs:enumeration value="ISMA_30/360"/>			<xs:enumeration value="30/360"/>			<xs:enumeration value="30U/360"/>			<xs:enumeration value="30E/360"/>			<xs:enumeration value="30E+/360"/>			<xs:enumeration value="ISDA_30E/360"/>			<xs:enumeration value="30/360M"/>			<xs:enumeration value="30/365"/>			<xs:enumeration value="ACT/360"/>			<xs:enumeration value="ACT/365"/>			<xs:enumeration value="ACT/365F"/>			<xs:enumeration value="ACT/365L"/>			<xs:enumeration value="ACT/ACT"/>			<xs:enumeration value="NL/365"/>			<xs:enumeration value="BUS/252"/>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="DistributionMethod">		<xs:restriction id="DistributionMethod" base="xs:string">			<xs:enumeration value="SYNDICATED">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">SYNDICATED</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Distribution is performed through a group of underwriters.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="NON-SYNDICATED">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">NON-SYNDICATED</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Distribution is performed through a single underwriter.</xs:documentation>				</xs:annotation>			</xs:enumeration>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="OptionType">		<xs:restriction id="OptionType" base="xs:string">			<xs:enumeration value="CALL">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">CALL</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Issuer has the right to purchase some amount of the outstanding bonds.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="PUT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">PUT</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Bond holders have the right to sell back some amount of the outstanding bonds.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="CHANGE_OF_CONTROL_PUT_EVENT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">CHANGE_OF_CONTROL_PUT_EVENT</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Bond holders have the right to sell back some amount of the outstanding bonds in the event of a significant change in corporate structure occurs.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="NOT_APPLICABLE"/>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="CalculationMethod">		<xs:restriction id="CalculationType" base="xs:string">			<xs:enumeration value="COMPOUNDING">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">COMPOUNDING</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Calculated interest is added to the principal and included in the next interest calculation.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="AVERAGING">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">AVERAGING</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Interest rate is the mathematical average of rates over a specified term.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="INDEX">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">INDEX</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Interest rate is calculated relative to a base rate of a specified index.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="LINEAR_INTERPOLATION">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">LINEAR_INTERPOLATION</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Interest rate is calculated by interpolation between two or more specified rates.</xs:documentation>				</xs:annotation>			</xs:enumeration>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="DeterminationMethod">		<xs:restriction id="DeterminationMethod" base="xs:string">			<xs:enumeration value="INDEX">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">INDEX</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Indicates the rate determination method is based on an index.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="CALCULATED">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">CALCULATED</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Indicates the rate determination method is calculated based on one of the specified methods.</xs:documentation>				</xs:annotation>			</xs:enumeration>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="ObservationMethod">		<xs:restriction id="ObservationMethod" base="xs:string">			<xs:enumeration value="OBSERVATION_SHIFT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">OBSERVATION_SHIFT</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">The date or period of observered interest rates is shifted to a prior period with adjusted weighting. </xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="LAG">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">LAG</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">The date or period of observered interest rates is referenced to a prior period while maintaining original weighting.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="LOOK_BACK">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">LOOK_BACK</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">The date or period of observered interest rates is referenced to a prior period while maintaining original weighting.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="LOCK_OUT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">LOOK_BACK</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">The reference rate is locked for a period prior to the end of the interest calculation period.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="PAYMENT_DELAY">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">PAYMENT_DELAY</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">The payment is delayed due to a non-payable date or other reason, but the interest payment amount is not adjusted.</xs:documentation>				</xs:annotation>			</xs:enumeration>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="TefraCode">		<xs:annotation>			<xs:documentation source="Name" xml:lang="EN">TefraCode</xs:documentation>			<xs:documentation source="Definition" xml:lang="EN"/>		</xs:annotation>		<xs:restriction id="TefraCode" base="xs:string">			<xs:enumeration value="TEFRA_C">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">TEFRA_C</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">U.S. Treasury regulations (§1.163-5(c)(2)(i)(C)) for issuing debt securities.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="TEFRA_D">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">TEFRA_D</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">U.S. Treasury Regulation §1.163-5(c)(2)(i)(D) for issuing debt securities.</xs:documentation>				</xs:annotation>			</xs:enumeration>		