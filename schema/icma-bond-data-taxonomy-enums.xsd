:restriction>	</xs:simpleType>	<xs:simpleType name="RedemptionAmountType">		<xs:restriction id="RedemptionAmountType" base="xs:string">			<xs:enumeration value="PRICE_PERCENT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">PRICE_PERCENT</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Redemption amount is based on a percentage of par.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="PER_ISSUE_AMOUNT">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">PER_ISSUE_AMOUNT</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Redemption amount is an amount per issue.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="PER_DENOMINATION">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">PER_DENOMINATION</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Redemption amount is an amount per unit or denomintation amount.</xs:documentation>				</xs:annotation>			</xs:enumeration>		</xs:restriction>	</xs:simpleType>	<xs:simpleType name="RedemptionPaymentBasisType">		<xs:restriction id="RedemptionPaymentBasisType" base="xs:string">			<xs:enumeration value="PAR">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">PAR</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Redemption is based on the principal amount of the note.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="PARTLY_PAID">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN">PARTLY_PAID</xs:documentation>					<xs:documentation source="Definition" xml:lang="EN">Redemption is based on a portion of the principal amount of the note.</xs:documentation>				</xs:annotation>			</xs:enumeration>			<xs:enumeration value="INDEX_LINKED">				<xs:annotation>					<xs:documentation source="Name" xml:lang="EN"